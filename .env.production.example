# Production environment template for docker-compose.prod.yml.
# Copy to .env.production, fill in real values, NEVER commit the filled
# version. .gitignore previously only matched the literal ".env" - real
# secrets files like .env.production weren't actually excluded at all
# until that was fixed alongside adding this file (now a proper ".env*"
# pattern, with .env.example/.env.production.example explicitly
# re-included since those ARE meant to be tracked).

# Generate with: openssl rand -base64 48
# Same trust model as DJANGO_INTERNAL_TOKEN between Django and Nest today
# (see the KIS ops runbook's "Rotate shared internal token" section) - a
# long, random, unguessable value, never the empty-string dev default.
# Every caller of this service (Django, Nest) needs the SAME value
# configured on their own side (as DJANGO_INTERNAL_TOKEN-equivalent for
# this service, whatever env var name they store it under) or every
# request gets a 401. Rotating it later means updating it here AND on
# every caller's side in the same maintenance window - a mismatch between
# this service and a caller silently breaks all uploads/job queries for
# that caller until they match again, so treat this as ops-runbook-worthy,
# not a set-once-and-forget value.
INTERNAL_TOKEN=

# Points at the EXISTING kis-postgres container (shared with Django/Nest,
# on kis-production-network) - this service does not run its own Postgres.
# `kis_video` must already exist as a database inside that instance before
# first deploy (a one-time `CREATE DATABASE kis_video;` run against
# kis-postgres, not something docker-compose.prod.yml does) - use the
# existing kis_user credentials (same ones Django/Nest already connect
# with) unless there's a real reason to provision a separate DB user.
DATABASE_URL=postgresql+psycopg://kis_user:REPLACE_WITH_REAL_KIS_USER_PASSWORD@kis-postgres:5432/kis_video

# Points at the EXISTING kis-redis container - DB index 4. NOT 0 (Django's
# general cache), NOT 1 (Django's CELERY_BROKER_URL - an earlier draft of
# this file wrongly used index 1 assuming it was free; it isn't, confirmed
# directly against production .env.django during the actual first deploy,
# 2026-09-07, when this collision was hit for real, not hypothesized), NOT
# 2 (Django's CELERY_RESULT_BACKEND), NOT 3 (Nest). Verify against the
# real .env.django/.env.nest again before ever changing this - don't trust
# this comment alone if the upstream config has since changed.
REDIS_URL=redis://:REPLACE_WITH_REAL_KIS_REDIS_PASSWORD@kis-redis:6379/4

# Reuse the existing KIS AWS credentials/bucket convention - see
# apps/media/storage_backends.py on the Django side. Do not create a
# separate bucket/credential pair for this service unless there's a real
# reason to (e.g. distinct IAM scoping) - ARCHITECTURE.md's explicit
# intent is reusing what already exists, not inventing a parallel one.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

# A durable path INSIDE the container - docker-compose.prod.yml already
# mounts the kis_video_uploads named volume here, so this only needs to
# change if that mount path changes too. Do not point this at the bind-
# mounted repo directory (there isn't one in prod) or anywhere that isn't
# the shared volume both api and worker mount.
UPLOAD_STAGING_DIR=/tmp/kis-video-uploads

# Hours a tus session can sit in 'uploading' before the hourly cleanup
# sweep (app/workers/cleanup.py) deletes its staging file and marks it
# expired. 24 is a reasonable default; only change this with a real reason
# (e.g. observed abandoned-upload volume causing real disk pressure).
UPLOAD_TTL_HOURS=24
